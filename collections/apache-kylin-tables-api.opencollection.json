{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apache Kylin REST Authentication Tables API",
    "version": "5.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tables",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Apache kylin Apache Kylin List Tables",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:7070/kylin/api/tables",
            "params": [
              {
                "name": "project",
                "value": "learn_kylin",
                "type": "query"
              },
              {
                "name": "ext",
                "value": "true",
                "type": "query"
              }
            ]
          },
          "docs": "List all tables loaded in a project."
        }
      ]
    }
  ],
  "bundled": true
}